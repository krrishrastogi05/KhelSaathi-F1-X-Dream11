{
  "name": "khel-saathi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Khel Saathi: a second-screen AI companion that teaches a new sport while you watch. Proof of concept on the 2024 São Paulo Grand Prix (OpenF1 replay).",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run api\" \"vite --host\"",
    "api": "tsx watch --env-file-if-exists=.env backend/src/server.ts",
    "web": "vite --host",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env backend/src/server.ts",
    "data": "tsx scripts/fetch-race.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p backend/tsconfig.json",
    "test": "tsx --test backend/test/*.test.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
