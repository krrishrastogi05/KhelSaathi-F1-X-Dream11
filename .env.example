# Port for the single service (API, SSE stream and the built app)
PORT=8797

# Optional public origin for the QR code, for example https://khel-saathi.onrender.com
# Leave empty to use the address the browser used (on localhost the server offers the LAN IP instead)
PUBLIC_URL=

# LLM: any OpenAI-compatible endpoint. LLM_* is tried first, then LLM2_*, then LLM3_*.
# Without keys the app still works and gives data-only answers (the card says so).
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss-120b
LLM2_BASE_URL=https://api.groq.com/openai/v1
LLM2_API_KEY=
LLM2_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=9000
